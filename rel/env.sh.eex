#!/bin/sh

# Distribution settings for a release. They matter only when nodes form a cluster
# (SUPER_PI_CLUSTER_STRATEGY other than none); a single node ignores them.
#
#   RELEASE_NODE            node name; default: super_pi@<SUPER_PI_NODE_HOST or the host name>
#   RELEASE_COOKIE          shared secret between the nodes; set it, do not rely on the generated one
#   SUPER_PI_NODE_HOST      the address the other nodes use to reach this one (a pod IP, a VM address);
#                           default: the IP for dnspoll and kubernetes_dns, the host name otherwise
#   SUPER_PI_DIST_PORT_MIN, SUPER_PI_DIST_PORT_MAX
#                           the range of distribution ports (default 9100 to 9155). Open it between
#                           the nodes, together with epmd (4369).

if [ -n "$SUPER_PI_CLUSTER_STRATEGY" ] && [ "$SUPER_PI_CLUSTER_STRATEGY" != "none" ]; then
  export RELEASE_DISTRIBUTION=name
  # dnspoll and kubernetes_dns name the other nodes `<basename>@<ip>`, so this node must use its IP too.
  case "$SUPER_PI_CLUSTER_STRATEGY" in
    dnspoll|kubernetes_dns) default_host="$(hostname -i 2>/dev/null | awk '{print $1}')" ;;
    *) default_host="$(hostname -f 2>/dev/null || hostname)" ;;
  esac
  host="${SUPER_PI_NODE_HOST:-$default_host}"
  export RELEASE_NODE="${RELEASE_NODE:-super_pi@${host}}"
  export ERL_AFLAGS="${ERL_AFLAGS} -kernel inet_dist_listen_min ${SUPER_PI_DIST_PORT_MIN:-9100} inet_dist_listen_max ${SUPER_PI_DIST_PORT_MAX:-9155}"

  if [ -z "$RELEASE_COOKIE" ]; then
    echo "SUPER_PI_CLUSTER_STRATEGY is set but RELEASE_COOKIE is not. Set the same cookie on every node." >&2
    exit 1
  fi
fi
