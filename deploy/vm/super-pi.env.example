# /etc/super-pi.env: one file per node. Only the node address differs between nodes.
SUPER_PI_STORAGE_BACKEND=postgres
DATABASE_URL=ecto://super_pi:CHANGE_ME@db.internal:5432/super_pi
SUPER_PI_DB_SSL=verify-full
SUPER_PI_DB_SSL_CA=/etc/ssl/certs/db-ca.pem
POOL_SIZE=10

SUPER_PI_GATEWAY=true
SUPER_PI_GATEWAY_BIND=0.0.0.0
SUPER_PI_GATEWAY_PORT=4000
SUPER_PI_GATEWAY_TOKEN=CHANGE_ME

# Cluster: every node lists all nodes (epmd), or use a DNS name (dnspoll).
SUPER_PI_CLUSTER_STRATEGY=epmd
SUPER_PI_CLUSTER_HOSTS=super_pi@10.0.0.11,super_pi@10.0.0.12,super_pi@10.0.0.13
RELEASE_NODE=super_pi@10.0.0.11          # this node's address
RELEASE_COOKIE=CHANGE_ME_LONG_RANDOM     # the same on every node
# Open between the nodes: TCP 4369 (epmd) and 9100-9155 (distribution). Keep it off the internet.

# A shared workspace that every node mounts (see "Workspaces and Artifacts" in the README):
# set the conversation workspace to {"kind": "shared", "root": "/mnt/super-pi/workspaces"}.
GEMINI_API_KEY=
