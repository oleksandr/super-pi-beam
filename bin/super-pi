#!/usr/bin/env bash
# ==============================================================================
# bin/super-pi — Main CLI entrypoint for the Super-Pi-BEAM Harness
# Supports:
#   super-pi                          Interactive chat (terminal) or one prompt from stdin (pipe)
#   super-pi run [prompt]             Run one prompt; reads stdin when no prompt is given
#   super-pi chat                     Interactive chat
#   super-pi gateway [port]           Run the OpenAI-compatible HTTP gateway
#   super-pi mcp                      Run standard Model Context Protocol server over stdio
#   super-pi rpc [--port P]           Run JSON-RPC 2.0 server
#   super-pi session list             List durable conversations
#   super-pi session show <ID>        Display conversation details
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${ROOT_DIR}"

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then CMD="chat"; else CMD="run"; fi
elif [[ "$1" =~ ^[0-9]+$ || "$1" == "--verbose" || "$1" == "-v" ]]; then
  CMD="gateway"
elif [[ "$1" =~ ^- ]]; then
  # Direct flag invocation, e.g. super-pi -p "hello" or super-pi --harness fast
  exec mise exec -- mix run -e '
    {code, out} = SuperPi.CLI.run(System.argv())
    if out != "", do: IO.puts(out)
    System.halt(code)
  ' -- "$@"
else
  CMD="$1"
  shift || true
fi

case "${CMD}" in
  gateway|serve)
    PORT="4000"
    VERBOSE="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --verbose|-v)
          VERBOSE="true"
          shift
          ;;
        *)
          if [[ "$1" =~ ^[0-9]+$ ]]; then
            PORT="$1"
          fi
          shift
          ;;
      esac
    done

    LOG_LEVEL="info"
    if [[ "${VERBOSE}" == "true" || "${DEBUG:-0}" == "1" || "${SUPER_PI_LOG_LEVEL:-}" == "debug" ]]; then
      LOG_LEVEL="debug"
    fi

    echo "Starting Super-Pi-BEAM Upstream Inference Gateway on http://127.0.0.1:${PORT} (log level: ${LOG_LEVEL})..." >&2
    exec mise exec -- mix run --no-halt -e "
      Logger.configure(level: :${LOG_LEVEL})
      Application.put_env(:super_pi, :gateway_port, ${PORT})
      {:ok, _} = Supervisor.start_child(SuperPi.Supervisor, {SuperPi.Gateway.Server, port: ${PORT}})
      Process.sleep(:infinity)
    "
    ;;

  mcp)
    if [[ $# -eq 0 ]]; then
      exec mise exec -- mix run -e "SuperPi.MCP.Server.run_stdio()"
    else
      exec mise exec -- mix run -e '
        {code, out} = SuperPi.CLI.run(["mcp" | System.argv()])
        if out != "", do: IO.puts(out)
        System.halt(code)
      ' -- "$@"
    fi
    ;;

  rpc)
    PORT="${1:-4001}"
    if ! [[ "${PORT}" =~ ^[0-9]+$ ]]; then
      echo "Error: port must be a valid numeric integer, got: ${PORT}" >&2
      exit 1
    fi
    echo "Starting SuperPi.RPC.Server on port ${PORT}..." >&2
    exec mise exec -- mix run --no-halt -e "SuperPi.RPC.Server.start_link(port: ${PORT}); Process.sleep(:infinity)"
    ;;

  harness|harnesses|models|agents|plugin|plugins|remote-control|run|chat)
    export SUPER_PI_CMD="${CMD}"
    exec mise exec -- mix run -e '
      cmd = System.get_env("SUPER_PI_CMD")
      {code, out} = SuperPi.CLI.run([cmd | System.argv()])
      if out != "", do: IO.puts(out)
      System.halt(code)
    ' -- "$@"
    ;;

  session)
    SUBCMD="${1:-list}"
    shift || true
    case "${SUBCMD}" in
      list)
        exec mise exec -- mix run -e '
          alias SuperPi.Repo
          alias SuperPi.Durable.Schemas.Conversation
          alias SuperPi.Durable.Doc
          import Ecto.Query
          convs = Repo.all(from c in Conversation, order_by: [desc: c.id], limit: 20)
          IO.puts(String.pad_trailing("ID", 8) <> String.pad_trailing("CREATED", 24) <> "AGENT MODEL")
          IO.puts(String.duplicate("-", 70))
          Enum.each(convs, fn c ->
            created = Calendar.strftime(c.inserted_at, "%Y-%m-%d %H:%M:%S")
            agent = Doc.snapshot("conversation", c.id, "pi.agent")
            model = (agent && agent["model"]) || "default"
            IO.puts(String.pad_trailing(to_string(c.id), 8) <> String.pad_trailing(created, 24) <> model)
          end)
        '
        ;;
      show)
        CONV_ID="${1:-}"
        if [[ -z "${CONV_ID}" ]] || ! [[ "${CONV_ID}" =~ ^[0-9]+$ ]]; then
          echo "Usage: super-pi session show <ID> (ID must be numeric)" >&2
          exit 1
        fi
        exec mise exec -- mix run -e "
          alias SuperPi.Repo
          alias SuperPi.Durable.Schemas.Conversation
          alias SuperPi.Durable.Doc
          conv = Repo.get!(Conversation, ${CONV_ID})
          IO.puts(\"Conversation ID: #{conv.id}\")
          IO.puts(\"Created: #{conv.inserted_at}\")
          IO.puts(\"pi.agent Document: #{inspect(Doc.snapshot(\"conversation\", conv.id, \"pi.agent\"), pretty: true)}\")
        "
        ;;
      *)
        echo "Unknown session subcommand: ${SUBCMD}" >&2
        echo "Available: list, show <ID>" >&2
        exit 1
        ;;
    esac
    ;;

  help|--help|-h)
    exec mise exec -- mix run -e '
      {_code, out} = SuperPi.CLI.run(["help"])
      IO.puts(out)
    '
    ;;

  *)
    exec mise exec -- mix run -e '
      args = System.argv()
      {code, out} = SuperPi.CLI.run(args)
      if out != "", do: IO.puts(out)
      System.halt(code)
    ' -- "${CMD}" "$@"
    ;;
esac
