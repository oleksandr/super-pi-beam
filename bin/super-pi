#!/usr/bin/env bash
# ==============================================================================
# bin/super-pi — Main CLI entrypoint for the Super-Pi-BEAM Harness
# Supports:
#   super-pi mcp                      Run standard Model Context Protocol server over stdio
#   super-pi rpc [--port P]           Run JSON-RPC 2.0 server
#   super-pi session list             List durable conversations
#   super-pi session show <ID>        Display conversation details
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${ROOT_DIR}"

CMD="${1:-help}"
shift || true

case "${CMD}" in
  mcp)
    exec mise exec -- mix run --no-halt -e "SuperPi.MCP.Server.run_stdio()"
    ;;

  rpc)
    PORT="${1:-4000}"
    echo "Starting SuperPi.RPC.Server on port ${PORT}..." >&2
    exec mise exec -- mix run --no-halt -e "SuperPi.RPC.Server.start_link(port: ${PORT}); Process.sleep(:infinity)"
    ;;

  session)
    SUBCMD="${1:-list}"
    shift || true
    case "${SUBCMD}" in
      list)
        exec mise exec -- mix run -e '
          alias SuperPi.Repo
          alias SuperPi.Durable.Schemas.Conversation
          alias SuperPi.Durable.Doc
          import Ecto.Query
          convs = Repo.all(from c in Conversation, order_by: [desc: c.id], limit: 20)
          IO.puts(String.pad_trailing("ID", 8) <> String.pad_trailing("CREATED", 24) <> "AGENT MODEL")
          IO.puts(String.duplicate("-", 70))
          Enum.each(convs, fn c ->
            created = Calendar.strftime(c.inserted_at, "%Y-%m-%d %H:%M:%S")
            agent = Doc.snapshot("conversation", c.id, "pi.agent")
            model = (agent && agent["model"]) || "default"
            IO.puts(String.pad_trailing(to_string(c.id), 8) <> String.pad_trailing(created, 24) <> model)
          end)
        '
        ;;
      show)
        CONV_ID="${1:-}"
        if [[ -z "${CONV_ID}" ]]; then
          echo "Usage: super-pi session show <ID>" >&2
          exit 1
        fi
        exec mise exec -- mix run -e "
          alias SuperPi.Repo
          alias SuperPi.Durable.Schemas.Conversation
          alias SuperPi.Durable.Doc
          conv = Repo.get!(Conversation, ${CONV_ID})
          IO.puts(\"Conversation ID: #{conv.id}\")
          IO.puts(\"Created: #{conv.inserted_at}\")
          IO.puts(\"pi.agent Document: #{inspect(Doc.snapshot(\"conversation\", conv.id, \"pi.agent\"), pretty: true)}\")
        "
        ;;
      *)
        echo "Unknown session subcommand: ${SUBCMD}" >&2
        echo "Available: list, show <ID>" >&2
        exit 1
        ;;
    esac
    ;;

  help|--help|-h)
    cat <<EOF
Usage: super-pi <command> [options]

Commands:
  mcp            Run standard Model Context Protocol (MCP) server over stdio
                 Connects directly to OpenCode, Claude Desktop, Cursor, and Zed
  rpc [port]     Run standalone JSON-RPC 2.0 server (default port: 4000)
  session list   List recent durable conversations
  session show   Display conversation state and documents
  help           Show this help text

Examples:
  # Connect to OpenCode:
  opencode mcp add super-pi

  # Or configure in ~/.config/opencode/opencode.json:
  "mcp": {
    "super-pi": {
      "type": "local",
      "command": ["${ROOT_DIR}/bin/super-pi", "mcp"],
      "enabled": true
    }
  }
EOF
    ;;

  *)
    echo "Unknown command: ${CMD}" >&2
    echo "Run 'super-pi help' for available commands." >&2
    exit 1
    ;;
esac
