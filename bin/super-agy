#!/usr/bin/env bash
set -euo pipefail

CALLER_CWD="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_DIR"

if [[ ! -x "$SCRIPT_DIR/bin/agy-tui" ]]; then
  (cd "$SCRIPT_DIR/clients/agy-tui" && mise exec -- go build -o "$SCRIPT_DIR/bin/agy-tui" ./cmd/agy-tui)
fi

# Check whether any non-interactive flag or subcommand was supplied
NON_INTERACTIVE=0
for arg in "$@"; do
  case "$arg" in
    -p|--print|--prompt|--help|-h|--input-format|agent|agents|models|mcp|plugin|plugins|remote-control|changelog|help)
      NON_INTERACTIVE=1
      ;;
  esac
done

if [[ "$NON_INTERACTIVE" -eq 1 ]]; then
  exec mise exec -- mix run --no-compile -e '
    {code, out} = SuperPi.AGY.CLI.run(System.argv(), interactive_tui: false)
    if out != "", do: IO.puts(out)
    System.halt(code)
  ' -- "$@"
fi

# Interactive mode:
# 1. Start the BEAM RPC server in the background and capture its TCP port + conversation ID
RPC_INFO_FILE="$(mktemp -t super-agy-rpc.XXXXXX)"
cleanup() {
  rm -f "$RPC_INFO_FILE"
  if [[ -n "${BEAM_PID:-}" ]] && kill -0 "$BEAM_PID" 2>/dev/null; then
    kill "$BEAM_PID" 2>/dev/null || true
    wait "$BEAM_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

SUPER_AGY_INFO_FILE="$RPC_INFO_FILE" SUPER_AGY_CALLER_CWD="$CALLER_CWD" \
  mise exec -- mix run --no-compile --no-halt -e '
    Logger.configure(level: :warning)
    {flags, _pos} =
      case SuperPi.AGY.CLI.parse_args(System.argv()) do
        {:run, f, p} -> {f, p}
        _ -> {%{model: nil, effort: "medium", mode: "auto", continue: false, conversation: nil, prompt_interactive: nil, add_dirs: []}, []}
      end

    caller_cwd = System.get_env("SUPER_AGY_CALLER_CWD") || File.cwd!()
    {:ok, rpc_pid} = SuperPi.RPC.Server.start_link(port: 0)
    port = SuperPi.RPC.Server.port(rpc_pid)

    info = %{
      "port" => port,
      "model" => flags.model || "gemini-3-flash-preview",
      "effort" => flags.effort || "medium",
      "mode" => flags.mode || "auto",
      "conversation" => flags.conversation || 0,
      "workspace" => caller_cwd,
      "prompt" => flags.prompt_interactive || ""
    }

    File.write!(System.fetch_env!("SUPER_AGY_INFO_FILE"), Jason.encode!(info))
  ' -- "$@" >/dev/null 2>&1 &
BEAM_PID=$!

# Wait up to 10s for the BEAM RPC server to write its port file
for _ in {1..100}; do
  if [[ -s "$RPC_INFO_FILE" ]]; then
    break
  fi
  if ! kill -0 "$BEAM_PID" 2>/dev/null; then
    echo "super-agy: BEAM RPC server exited unexpectedly" >&2
    exit 1
  fi
  sleep 0.1
done

if [[ ! -s "$RPC_INFO_FILE" ]]; then
  echo "super-agy: timed out waiting for SuperPi.RPC.Server to start" >&2
  exit 1
fi

PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["port"])' "$RPC_INFO_FILE")"
MODEL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["model"])' "$RPC_INFO_FILE")"
EFFORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["effort"])' "$RPC_INFO_FILE")"
MODE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["mode"])' "$RPC_INFO_FILE")"
CONV="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["conversation"])' "$RPC_INFO_FILE")"
WORKSPACE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["workspace"])' "$RPC_INFO_FILE")"
PROMPT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["prompt"])' "$RPC_INFO_FILE")"

# 2. Run the Go Bubble Tea TUI directly in the foreground owning the user TTY
"$SCRIPT_DIR/bin/agy-tui" \
  --rpc-addr "127.0.0.1:${PORT}" \
  --conversation "${CONV}" \
  --model "${MODEL}" \
  --effort "${EFFORT}" \
  --mode "${MODE}" \
  --workspace "${WORKSPACE}" \
  --prompt "${PROMPT}"
